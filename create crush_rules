# rules
rule replicated_rule {
	id 0
	type replicated
	step take default
	step chooseleaf firstn 0 type host
	step emit
}
rule SSD_Rule {
	id 1
        type replicated
        step take dc1 class ssd
        step chooseleaf firstn 2 type osd
        step emit
        step take dc2 class ssd
        step chooseleaf firstn 1 type osd
        step emit
}
rule volume_hdd {
	id 2
        type replicated
        step take dc1 class hdd
        step chooseleaf firstn 2 type osd
        step emit
        step take dc2 class hdd
        step chooseleaf firstn 1 type osd
        step emit
}
