create dc1 and dc2 for crushmap 
ceph osd getcrushmap -o {compiled-crushmap-filename}                           #first get crush 
crushtool -d {compiled-crushmap-filename} -o {decompiled-crushmap-filename}    #second decompail file 
cp    <decompiled-crushmap-filename>  <decompiled-crushmap-filename>.bk        #copy decompile file ceph  (backup we want rollingupdate to crush) 
crushtool -c {decompiled-crushmap-filename} -o {compiled-crushmap-filename}    #third recomale rules 
ceph osd setcrushmap -i {compiled-crushmap-filename}                           #set crush rules for ceph 
